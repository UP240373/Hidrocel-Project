{
  "name": "hidrocel-project",
  "version": "1.0.0",
  "description": "Hidrocel Project - Cotizaciones y seguimiento",
  "main": "backend/endpoints.js",
  "bin": "backend/endpoints.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "backend": "node backend/endpoints.js",
    "frontend": "cd frontend && npm run dev",
    "project": "concurrently \"npm run frontend\" \"npm run backend\"",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm install",
    "build": "npm run build:frontend && npm run build:backend",
    "start:prod": "node backend/endpoints.js",
    "build:exe": "pkg . --output hidrocel-app.exe",
    "build:exe:debug": "pkg . --debug --output hidrocel-app.exe --options no-bytecode,no-native,public",
    "export": "npm run build && npm run build:exe && mkdir distribution 2>nul && copy hidrocel-app.exe distribution\\ && copy .env distribution\\ 2>nul",
    "startExe": ".\\hidrocel-app.exe"
  },
  "pkg": {
    "scripts": [
      "backend/**/*.js",
      "frontend/.next/**/*.js",
      "frontend/.next/**/*.json",
      "!backend/node_modules/brotli/**/*.js",
      "!backend/node_modules/rxjs/**/*.js",
      "!backend/node_modules/**/build/**/*.js",
      "!backend/node_modules/**/dist/esm/**/*.js",
      "!backend/**/*.test.js",
      "!backend/**/*.spec.js"
    ],
    "assets": [
      "frontend/.next/**/*",
      "frontend/.next/**/*.json",
      "frontend/.next/**/*.html",
      "frontend/.next/**/*.css",
      "frontend/.next/**/*.map",
      "frontend/public/**/*",
      "backend/**/*.json",
      "backend/**/*.html",
      "backend/**/*.css",
      ".env",
      "package.json",
      "frontend/package.json"
    ],
    "targets": ["node18-win-x64"],
    "outputPath": "dist",
    "options": {
      "no-native": true,
      "no-bytecode": true,
      "public": true
    }
  },
  "keywords": [],
  "author": "Abdul Gerardo Martinez Campos",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.22.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}